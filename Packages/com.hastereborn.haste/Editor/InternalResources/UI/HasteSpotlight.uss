/* Haste palette styling.
 *
 * Values are taken verbatim from the "Unity Spotlight" design (artboard 1a) rather than
 * re-derived, so a change there is a one-for-one edit here.
 *
 * Two things in that design cannot be expressed in USS and are deliberately absent:
 *   - the outer drop shadow (0 24px 60px rgba(0,0,0,.55)). USS has no box-shadow; it
 *     would need a nine-sliced background image, and a popup window has no surface
 *     outside itself to cast onto anyway.
 */

/* The window's own root. It must be OPAQUE and square: an editor window is a rectangular
 * surface with no per-pixel transparency, so a radius here does not round the window --
 * it carves the corners out of the content and lets whatever the editor paints underneath
 * show through, which is lighter than the palette and reads as a border.
 *
 * #141414 is the design's own backdrop colour (the card the window sits on in artboard
 * 1a), so the corners left by the frame's radius look deliberate rather than like a leak. */
.haste-backdrop {
    flex-grow: 1;
    background-color: #141414;
}

.haste-root {
    flex-grow: 1;
    background-color: #232323;
    border-width: 1px;
    border-color: #0d0d0d;
    border-radius: 12px;
    overflow: hidden;
}

/* ---------------------------------------------------------------- header */

.haste-header {
    flex-direction: row;
    align-items: center;
    padding-top: 14px;
    padding-right: 16px;
    padding-bottom: 12px;
    padding-left: 16px;
}

.haste-badge {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 6px;
    background-color: #343434;
    border-width: 1px;
    border-color: #3f3f3f;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    -unity-font-style: bold;
    color: #8f8f8f;
    margin-right: 12px;
}

/* The committed scope chip, e.g. "prefab x". */
.haste-scope {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-top: 4px;
    padding-right: 9px;
    padding-bottom: 4px;
    padding-left: 9px;
    border-radius: 6px;
    background-color: rgba(201, 118, 44, 0.33);
    border-width: 1px;
    border-color: #c9762c;
    font-size: 12px;
    color: #f5e0c8;
    margin-right: 12px;
}

.haste-scope-clear {
    color: #d8a877;
    margin-left: 6px;
}

/* Wraps the field so the placeholder can sit on top of it. */
.haste-query-slot {
    flex-grow: 1;
    justify-content: center;
}

.haste-query {
    flex-grow: 1;
    margin: 0;
}

/* Unity's TextField has no placeholder, so this is a label laid over the field. It
 * ignores picking so clicks still land on the input underneath. */
.haste-placeholder {
    position: absolute;
    left: 2px;
    font-size: 19px;
    color: #5c5c5c;
}

.haste-query > .unity-text-field__input,
.haste-query .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    padding: 0;
    margin: 0;
    font-size: 19px;
    color: #f2f2f2;
    -unity-text-align: middle-left;
}

/* Prefix hint chips, shown only before a scope is committed. */
.haste-hints {
    flex-direction: row;
    padding-right: 16px;
    padding-bottom: 10px;
    padding-left: 16px;
}

/* Clickable: each one types its tag into the query. Styled to say so. */
.haste-hint {
    padding-top: 3px;
    padding-right: 8px;
    padding-bottom: 3px;
    padding-left: 8px;
    margin-right: 6px;
    border-radius: 5px;
    background-color: rgba(201, 118, 44, 0.2);
    border-width: 1px;
    border-color: rgba(201, 118, 44, 0.5);
    font-size: 10px;
    color: #f0d0ac;
}

.haste-hint:hover {
    background-color: rgba(201, 118, 44, 0.45);
    border-color: #c9762c;
    color: #ffe9cf;
}

.haste-divider {
    height: 1px;
    background-color: #141414;
    flex-shrink: 0;
}

/* ------------------------------------------------------------------ list */

.haste-body {
    flex-grow: 1;
    overflow: hidden;
}

/* Results and actions sit side by side on a double-width track that slides.
 *
 * The design specifies cubic-bezier(.4, 0, .2, 1). USS HAS NO cubic-bezier -- it takes
 * named easings only. Writing one does not fail the import, it produces a declaration
 * with ZERO values, and ComputedStyle.ApplyGlobalKeyword then indexes past the end of
 * that empty list on every repaint: ArgumentOutOfRangeException the moment the palette
 * opens. ease-in-out is the nearest named curve. */
.haste-track {
    flex-direction: row;
    width: 200%;
    height: 100%;
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-in-out;
}

.haste-track--actions {
    translate: -50% 0;
}

.haste-pane {
    width: 50%;
    height: 100%;
    flex-shrink: 0;
}

/* ---------------------------------------------------------- actions pane */

.haste-pane-header {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-right: 8px;
    padding-bottom: 9px;
    padding-left: 8px;
}

.haste-back {
    flex-shrink: 0;
    padding-top: 2px;
    padding-right: 6px;
    padding-bottom: 2px;
    padding-left: 6px;
    margin-right: 9px;
    border-radius: 4px;
    background-color: #2e2e2e;
    border-width: 1px;
    border-color: #3b3b3b;
    font-size: 10px;
    color: #9c9c9c;
    -unity-text-align: middle-center;
}

.haste-pane-title {
    flex-shrink: 1;
    font-size: 12px;
    color: #eaeaea;
    overflow: hidden;
    text-overflow: ellipsis;
}

.haste-pane-divider {
    height: 1px;
    background-color: #2c2c2c;
    margin-right: 8px;
    margin-bottom: 6px;
    margin-left: 8px;
}

.haste-actions-list {
    flex-grow: 1;
    padding-right: 8px;
    padding-left: 8px;
}

.haste-pane-action {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-right: 10px;
    padding-left: 10px;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
}

.haste-pane-action:hover {
    background-color: #2c2c2c;
}

.haste-pane-action--selected,
.haste-pane-action--selected:hover {
    background-color: #343434;
}

.haste-pane-action-label {
    font-size: 12px;
    color: #e6e6e6;
}

.haste-pane-action--destructive .haste-pane-action-label {
    color: #d98a86;
}

.haste-pane-action-keys {
    font-size: 10px;
    color: #7d7d7d;
}

.haste-flash {
    margin-top: 10px;
    margin-right: 8px;
    margin-left: 8px;
    padding-top: 7px;
    padding-right: 9px;
    padding-bottom: 7px;
    padding-left: 9px;
    border-radius: 6px;
    background-color: #26332b;
    border-width: 1px;
    border-color: #354a3b;
    font-size: 11px;
    color: #a8c9b1;
    white-space: normal;
}

.haste-list {
    flex-grow: 1;
    padding-top: 8px;
    padding-right: 8px;
    padding-left: 8px;
    background-color: #232323;
}

/* ListView, in its default reorder mode, puts its item classes on THE ELEMENT that
 * makeItem RETURNS -- our .haste-row -- not on a wrapper around it. Two consequences,
 * both of which bit:
 *
 *   - A rule written as `--selected > .haste-row` matches nothing. There is no child to
 *     match; the selected item IS the row.
 *   - This rule is (0,2,0) and `.haste-row--highlighted` was (0,1,0), so clearing the
 *     background here silently out-specified the highlight and no row ever lit up. Only
 *     the tag looked selected, because its rule was a descendant selector and did match.
 *
 * So: clear only what Unity itself paints, and set every state below it at a specificity
 * that beats it. The descendant forms are kept as well, in case a future reorder mode
 * does wrap the row. */
.haste-list .unity-collection-view__item,
.haste-list .unity-list-view__item {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.haste-list .haste-row:hover {
    background-color: #2c2c2c;
}

/* The highlight comes from two places on purpose: ListView's own selected state, which
 * follows the selection without needing a rebind, and the modifier class BindRow writes,
 * which covers the first bind. ListView does not rebind an already-realised row when only
 * the selection moves, so neither alone is enough. They always agree, because the keyboard
 * highlight and the ListView selection are kept in step. */
.haste-list .unity-collection-view__item--selected,
.haste-list .unity-list-view__item--selected,
.haste-list .unity-collection-view__item--selected .haste-row,
.haste-list .haste-row--highlighted,
.haste-list .haste-row--highlighted:hover {
    background-color: #343434;
}

.haste-list .unity-collection-view__item--selected .haste-tag,
.haste-list .unity-list-view__item--selected .haste-tag,
.haste-list .haste-row--highlighted .haste-tag {
    color: #a8a8a8;
    background-color: #3f3f3f;
    border-color: #4a4a4a;
}

.haste-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding-right: 10px;
    padding-left: 10px;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
}

.haste-tag {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    background-color: #2f2f2f;
    border-width: 1px;
    border-color: #3a3a3a;
    margin-right: 11px;
    background-size: 16px 16px;
    background-position: center;
    background-repeat: no-repeat;
}

/* Rows that carry a real asset icon drop the badge chrome so the icon reads as itself. */
.haste-tag--icon {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

/* The fallback label, for items with no icon: menu commands and layouts.
 *
 * -unity-text-align is what centres TEXT. The flex align-items/justify-content on the
 * badge only centre the label ELEMENT inside it, which is why these read top-left before.
 */
.haste-tag-text {
    font-size: 8px;
    -unity-font-style: bold;
    color: #8a8a8a;
    -unity-text-align: middle-center;
    width: 100%;
}

.haste-name {
    flex-shrink: 1;
    font-size: 13px;
    color: #eaeaea;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.haste-name--disabled { color: #7a7a7a; }
.haste-name--prefab   { color: #7fb2e5; }
.haste-name--broken   { color: #d98a86; }

.haste-spacer { flex-grow: 1; }

.haste-path {
    flex-shrink: 0;
    max-width: 330px;
    font-size: 11px;
    color: #6b6b6b;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-right;
    padding-left: 10px;
}

/* Multi-selection marker. The design has no multi-select state, so this is the smallest
 * treatment consistent with it: the same dot the old palette used, in the accent. */
.haste-dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 3px;
    background-color: #c9762c;
    margin-left: 9px;
}

/* --------------------------------------------------------- empty / intro */

.haste-message {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.haste-message-box {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #3d3d3d;
    margin-bottom: 10px;
}

.haste-message-title {
    font-size: 13px;
    color: #7a7a7a;
    margin-bottom: 10px;
}

.haste-message-hint {
    font-size: 11px;
    color: #4f4f4f;
}

/* ---------------------------------------------------------------- footer */

.haste-footer {
    flex-direction: row;
    align-items: center;
    padding-top: 5px;
    padding-right: 12px;
    padding-bottom: 5px;
    padding-left: 12px;
    background-color: #1e1e1e;
    flex-shrink: 0;
}

.haste-footer-icon {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background-color: #2f2f2f;
    border-width: 1px;
    border-color: #3a3a3a;
    margin-right: 9px;
    flex-shrink: 0;
}

.haste-footer-icon--indexing { border-color: #c9762c; }

.haste-status {
    font-size: 11px;
    color: #6b6b6b;
    flex-shrink: 1;
    overflow: hidden;
}

.haste-action-label {
    font-size: 11px;
    color: #c8c8c8;
    margin-right: 6px;
}

.haste-key {
    min-width: 18px;
    padding-top: 2px;
    padding-right: 5px;
    padding-bottom: 2px;
    padding-left: 5px;
    border-radius: 4px;
    background-color: #2e2e2e;
    border-width: 1px;
    border-color: #3b3b3b;
    font-size: 10px;
    color: #9c9c9c;
    -unity-text-align: middle-center;
}

.haste-footer-hint {
    flex-direction: row;
    align-items: center;
    margin-left: 10px;
}

.haste-footer-separator {
    width: 1px;
    height: 16px;
    background-color: #2e2e2e;
    margin-right: 4px;
    margin-left: 4px;
}

.haste-count {
    flex-shrink: 0;
    padding-top: 2px;
    padding-right: 7px;
    padding-bottom: 2px;
    padding-left: 7px;
    margin-right: 9px;
    border-radius: 5px;
    background-color: rgba(201, 118, 44, 0.33);
    border-width: 1px;
    border-color: #c9762c;
    font-size: 10px;
    color: #f5e0c8;
}
