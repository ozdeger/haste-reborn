/* Haste palette styling.
 *
 * Values are taken verbatim from the "Unity Spotlight" design (artboard 1a) rather than
 * re-derived, so a change there is a one-for-one edit here.
 *
 * Two things in that design cannot be expressed in USS and are deliberately absent:
 *   - the outer drop shadow (0 24px 60px rgba(0,0,0,.55)). USS has no box-shadow; it
 *     would need a nine-sliced background image, and a popup window has no surface
 *     outside itself to cast onto anyway.
 */

/* The window is SQUARE, and the design's 12px radius is deliberately not applied here.
 *
 * An editor window is a rectangular surface with no per-pixel transparency, so a radius
 * on the outermost element does not round the window -- it carves the corners out of the
 * palette and lets whatever is behind it show through. The frame used to carry the radius
 * with a darker backdrop behind it so the carved corners read as intentional, but the
 * result is a rounded card sitting on a visible square plate, which is not what the design
 * shows and not what any other Unity popup looks like. Square is the honest version.
 *
 * Rounding the window for real needs per-pixel window transparency, which UI Toolkit does
 * not expose. The radius stays on everything INSIDE -- rows, chips, badges -- where there
 * is a real surface behind it to round against.
 *
 * The two elements remain because the outer one is the window's own root, which has to
 * exist regardless; it just paints the same colour now so no sliver of it can show. */
.haste-backdrop {
    flex-grow: 1;
    background-color: #232323;
}

.haste-root {
    flex-grow: 1;
    background-color: #232323;
    border-width: 1px;
    border-color: #0d0d0d;
    overflow: hidden;
}

/* ---------------------------------------------------------------- header */

/* No padding on the top or the LEFT, so the mark sits in the window's corner rather than
 * inset from it. The mark is the tallest child and the header has no vertical padding, so
 * it fills the header's height by definition -- there is no alignment to set.
 *
 * The query text is not left stranded against the window edge by this: the mark's own
 * width and right margin are what inset it now. Everything to the right of the mark still
 * centres vertically in the row. */
.haste-header {
    flex-direction: row;
    align-items: center;
    padding-top: 0;
    padding-right: 16px;
    padding-bottom: 0;
    padding-left: 0;
}

/* Haste's mark, sitting straight against the query text with nothing around it.
 *
 * The plate and its border were there to give the placeholder LETTER a shape to sit in.
 * A logo does not need one -- and an 18px flame inside a 26px chip was small enough to
 * read as a smudge rather than as a mark.
 *
 * A 48px square in the corner, and the tallest thing in the header, so it is what sets
 * the header's height -- 48 against the ~52 the header measured before, so the results
 * list below gains a few pixels rather than losing any.
 *
 * The three 48s go together: the element is square and the image fills it exactly, so
 * there is no letterboxing inside the box and no cropping of the mark. Changing the size
 * means changing all three. */
.haste-badge {
    width: 48px;
    height: 48px;
    flex-shrink: 0;

    /* Small, because the mark does not fill its own 48px box -- haste_icon.png carries a
     * transparent margin, so there is already a gap of empty pixels on the right of the
     * flame before this margin starts. Measuring the box rather than the ink is what made
     * the text look pushed away from a mark that sits tight against the window edge. */
    margin-right: 4px;

    background-size: 48px 48px;
    background-position: center;
    background-repeat: no-repeat;
}

/* The committed scope chip, e.g. "prefab x". */
.haste-scope {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-top: 4px;
    padding-right: 9px;
    padding-bottom: 4px;
    padding-left: 9px;
    border-radius: 6px;
    background-color: rgba(201, 118, 44, 0.33);
    border-width: 1px;
    border-color: #c9762c;
    font-size: 12px;
    color: #f5e0c8;
    margin-right: 12px;
}

.haste-scope-clear {
    color: #d8a877;
    margin-left: 6px;
}

/* Wraps the field so the placeholder can sit on top of it.
 *
 * The height is FIXED, and that is load-bearing. Without it the slot measured whatever
 * Unity's TextField reported, which is not the same for an empty field as for one with
 * text in it -- so the whole query line jumped the moment you typed the first character.
 * The header is 48px tall now regardless, set by the mark, so there is room to spend on
 * making this deterministic. */
.haste-query-slot {
    flex-grow: 1;
    justify-content: center;
    height: 30px;
}

.haste-query {
    flex-grow: 1;
    margin: 0;
    height: 100%;
}

/* Unity's TextField has no placeholder, so this is a label laid over the field. It
 * ignores picking so clicks still land on the input underneath.
 *
 * Stretched top to bottom and centred, rather than left to fall wherever an absolutely
 * positioned element with no vertical anchor lands. It has to sit on exactly the same
 * baseline as the real input, which centres itself in the same box -- otherwise the text
 * appears to hop as the placeholder gives way to it. */
.haste-placeholder {
    position: absolute;
    left: 2px;
    top: 0;
    bottom: 0;
    font-size: 19px;
    color: #5c5c5c;
    -unity-text-align: middle-left;
}

.haste-query > .unity-text-field__input,
.haste-query .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    padding: 0;
    margin: 0;
    font-size: 19px;
    color: #f2f2f2;
    -unity-text-align: middle-left;

    /* Fill the row and CENTRE the text element inside it, rather than stretching the text
     * element to fill. Those are not the same thing, and the difference is the caret: it
     * is drawn from the top-left of the text element, and -unity-text-align has no text to
     * align while the field is empty, so a stretched element puts the caret at the top of
     * the whole row. Centring a line-height element puts it exactly where the first
     * character will appear. */
    height: 100%;
    justify-content: center;
}

/* Deliberately NOT given a height. The inner text element (Unity builds
 * TextField > TextInput > TextElement, verified against 6000.3.17f1) keeps its natural
 * line height and is centred by its parent above; stretching it here is what left the
 * caret sitting high with an empty field. */
.haste-query .unity-text-element {
    -unity-text-align: middle-left;
}

/* Prefix hint chips, shown only before a scope is committed. */
.haste-hints {
    flex-direction: row;
    padding-right: 16px;
    padding-bottom: 10px;
    padding-left: 16px;
}

/* Clickable: each one types its tag into the query. Styled to say so. */
.haste-hint {
    padding-top: 3px;
    padding-right: 8px;
    padding-bottom: 3px;
    padding-left: 8px;
    margin-right: 6px;
    border-radius: 5px;
    background-color: rgba(201, 118, 44, 0.2);
    border-width: 1px;
    border-color: rgba(201, 118, 44, 0.5);
    font-size: 10px;
    color: #f0d0ac;
}

.haste-hint:hover {
    background-color: rgba(201, 118, 44, 0.45);
    border-color: #c9762c;
    color: #ffe9cf;
}

.haste-divider {
    height: 1px;
    background-color: #141414;
    flex-shrink: 0;
}

/* ------------------------------------------------------------------ list */

.haste-body {
    flex-grow: 1;
    overflow: hidden;
}

/* Results and actions sit side by side on a double-width track that slides.
 *
 * The design specifies cubic-bezier(.4, 0, .2, 1). USS HAS NO cubic-bezier -- it takes
 * named easings only. Writing one does not fail the import, it produces a declaration
 * with ZERO values, and ComputedStyle.ApplyGlobalKeyword then indexes past the end of
 * that empty list on every repaint: ArgumentOutOfRangeException the moment the palette
 * opens. ease-in-out is the nearest named curve. */
.haste-track {
    flex-direction: row;
    width: 200%;
    height: 100%;
    translate: 0 0;
    transition-property: translate;

    /* ease-OUT, not ease-in-out: an in-out curve starts slowly, and on a movement this
     * short the slow start is the whole of what reads as a wait before anything happens.
     * 0.12s rather than 0.18 for the same reason. */
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.haste-track--actions {
    translate: -50% 0;
}

.haste-pane {
    width: 50%;
    height: 100%;
    flex-shrink: 0;
}

/* ---------------------------------------------------------- actions pane */

.haste-pane-header {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-right: 8px;
    padding-bottom: 9px;
    padding-left: 8px;
}

.haste-back {
    flex-shrink: 0;
    padding-top: 2px;
    padding-right: 6px;
    padding-bottom: 2px;
    padding-left: 6px;
    margin-right: 9px;
    border-radius: 4px;
    background-color: #2e2e2e;
    border-width: 1px;
    border-color: #3b3b3b;
    font-size: 10px;
    color: #9c9c9c;
    -unity-text-align: middle-center;
}

.haste-pane-title {
    flex-shrink: 1;
    font-size: 12px;
    color: #eaeaea;
    overflow: hidden;
    text-overflow: ellipsis;
}

.haste-pane-divider {
    height: 1px;
    background-color: #2c2c2c;
    margin-right: 8px;
    margin-bottom: 6px;
    margin-left: 8px;
}

/* The actions pane is a list of rows, so it is built out of the same measurements as the
 * results list beside it: 32px tall, 10px of side padding, a 7px radius, and the same two
 * greys for hover and selection. They sit side by side in the track, so anything that did
 * not line up read as a mistake -- which is what it was. */
/* Moving between LEVELS of a context menu: a SHORT throw plus a fade, not a full-width
 * slide.
 *
 * The full-width version travelled the whole pane, which on rows this wide means a lot of
 * text crossing a lot of screen at speed -- legible as direction, unpleasant to look at,
 * and the wider the window the worse it gets, because the distance grows while the
 * duration does not.
 *
 * 14px carries the direction just as clearly. Direction in a transition is read from
 * which WAY something moves, not from how far, and once the fade is doing the work of
 * saying "this is different content" the offset only has to hint. The result is softer to
 * look at and reads as faster despite being about the same length, because nothing is
 * ever moving quickly.
 *
 * Note this is NOT the same mechanism as .haste-track's slide, which is structural -- the
 * track really does move the actions pane in from off-screen. This one is content being
 * replaced in a pane that is already where it belongs. */
.haste-actions-list {
    flex-grow: 1;
    padding-right: 8px;
    padding-left: 8px;
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.11s;
    transition-timing-function: ease-out;
}

/* The starting state, worn for exactly one frame. The zero duration is what makes the
 * jump to it instant, so only the journey back is animated -- without it the list would
 * travel out and then back, taking twice as long to say half as much. */
.haste-actions-list--from-right {
    translate: 14px 0;
    opacity: 0;
    transition-duration: 0s;
}

.haste-actions-list--from-left {
    translate: -14px 0;
    opacity: 0;
    transition-duration: 0s;
}

.haste-pane-action {
    flex-direction: row;
    align-items: center;
    height: 32px;

    /* Without this the rows do not keep that height. Flex items shrink by default, and a
     * 26-entry context menu in a pane ten rows tall squeezed each one down to about 12px
     * of crammed text. The ScrollView is the other half of the fix. */
    flex-shrink: 0;

    padding-right: 10px;
    padding-left: 10px;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
}

.haste-pane-action:hover {
    background-color: #2c2c2c;
}

.haste-pane-action--selected,
.haste-pane-action--selected:hover {
    background-color: #343434;
}

/* Same treatment as .haste-name, so a row on this side of the track sits on the same
 * baseline as a row on the other. */
.haste-pane-action-label {
    flex-shrink: 1;
    font-size: 13px;
    color: #eaeaea;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.haste-pane-action--destructive .haste-pane-action-label {
    color: #d98a86;
}

/* And this is .haste-path's treatment: the trailing, quieter half of a row. */
.haste-pane-action-keys {
    flex-shrink: 0;
    font-size: 11px;
    color: #6b6b6b;
    -unity-text-align: middle-right;
    padding-left: 10px;
}

/* The chevron on a row that opens a submenu. Brighter than a key hint because it is an
 * affordance rather than a legend -- it says the right arrow does something here. */
.haste-pane-action--submenu .haste-pane-action-keys {
    font-size: 13px;
    color: #8f8f8f;
}

.haste-pane-action--selected .haste-pane-action-keys {
    color: #a8a8a8;
}

.haste-flash {
    margin-top: 10px;
    margin-right: 8px;
    margin-left: 8px;
    padding-top: 7px;
    padding-right: 9px;
    padding-bottom: 7px;
    padding-left: 9px;
    border-radius: 6px;
    background-color: #26332b;
    border-width: 1px;
    border-color: #354a3b;
    font-size: 11px;
    color: #a8c9b1;
    white-space: normal;
}

.haste-list {
    flex-grow: 1;
    padding-top: 8px;
    padding-right: 8px;
    padding-left: 8px;
    background-color: #232323;
}

/* ListView, in its default reorder mode, puts its item classes on THE ELEMENT that
 * makeItem RETURNS -- our .haste-row -- not on a wrapper around it. Two consequences,
 * both of which bit:
 *
 *   - A rule written as `--selected > .haste-row` matches nothing. There is no child to
 *     match; the selected item IS the row.
 *   - This rule is (0,2,0) and `.haste-row--highlighted` was (0,1,0), so clearing the
 *     background here silently out-specified the highlight and no row ever lit up. Only
 *     the tag looked selected, because its rule was a descendant selector and did match.
 *
 * So: clear only what Unity itself paints, and set every state below it at a specificity
 * that beats it. The descendant forms are kept as well, in case a future reorder mode
 * does wrap the row. */
.haste-list .unity-collection-view__item,
.haste-list .unity-list-view__item {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.haste-list .haste-row:hover {
    background-color: #2c2c2c;
}

/* The highlight comes from two places on purpose: ListView's own selected state, which
 * follows the selection without needing a rebind, and the modifier class BindRow writes,
 * which covers the first bind. ListView does not rebind an already-realised row when only
 * the selection moves, so neither alone is enough. They always agree, because the keyboard
 * highlight and the ListView selection are kept in step. */
.haste-list .unity-collection-view__item--selected,
.haste-list .unity-list-view__item--selected,
.haste-list .unity-collection-view__item--selected .haste-row,
.haste-list .haste-row--highlighted,
.haste-list .haste-row--highlighted:hover {
    background-color: #343434;
}

.haste-list .unity-collection-view__item--selected .haste-tag,
.haste-list .unity-list-view__item--selected .haste-tag,
.haste-list .haste-row--highlighted .haste-tag {
    color: #a8a8a8;
    background-color: #3f3f3f;
    border-color: #4a4a4a;
}

.haste-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding-right: 10px;
    padding-left: 10px;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
}

.haste-tag {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    background-color: #2f2f2f;
    border-width: 1px;
    border-color: #3a3a3a;
    margin-right: 11px;
    background-size: 16px 16px;
    background-position: center;
    background-repeat: no-repeat;
}

/* Rows that carry a real asset icon drop the badge chrome so the icon reads as itself. */
.haste-tag--icon {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

/* The fallback label, for items with no icon: menu commands and layouts.
 *
 * -unity-text-align is what centres TEXT. The flex align-items/justify-content on the
 * badge only centre the label ELEMENT inside it, which is why these read top-left before.
 */
.haste-tag-text {
    font-size: 8px;
    -unity-font-style: bold;
    color: #8a8a8a;
    -unity-text-align: middle-center;
    width: 100%;
}

.haste-name {
    flex-shrink: 1;
    font-size: 13px;
    color: #eaeaea;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.haste-name--disabled { color: #7a7a7a; }
.haste-name--prefab   { color: #7fb2e5; }
.haste-name--broken   { color: #d98a86; }

.haste-spacer { flex-grow: 1; }

.haste-path {
    flex-shrink: 0;
    max-width: 330px;
    font-size: 11px;
    color: #6b6b6b;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-right;
    padding-left: 10px;
}

/* Multi-selection marker. The design has no multi-select state, so this is the smallest
 * treatment consistent with it: the same dot the old palette used, in the accent. */
/* The favourite marker, immediately after the name. The editor's own Favorite_colored
 * icon, so it reads as the same idea as the Project window's favourites rather than as a
 * second status dot. Sized and positioned like .haste-tag's background image. */
.haste-star {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    margin-left: 6px;
    background-size: 12px 12px;
    background-position: center;
    background-repeat: no-repeat;
}

.haste-dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 3px;
    background-color: #c9762c;
    margin-left: 9px;
}

/* --------------------------------------------------------- empty / intro */

.haste-message {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.haste-message-box {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #3d3d3d;
    margin-bottom: 10px;
}

.haste-message-title {
    font-size: 13px;
    color: #7a7a7a;
    margin-bottom: 10px;
}

.haste-message-hint {
    font-size: 11px;
    color: #4f4f4f;
}

/* ---------------------------------------------------------------- footer */

.haste-footer {
    flex-direction: row;
    align-items: center;
    padding-top: 5px;
    padding-right: 12px;
    padding-bottom: 5px;
    padding-left: 12px;
    background-color: #1e1e1e;
    flex-shrink: 0;
}

/* Haste's badge, the way into its preferences, and the indexing light, all one element.
 * Sized like .haste-tag's background image so the glyph does not fill the whole badge. */
.haste-footer-icon {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background-color: #2f2f2f;
    border-width: 1px;
    border-color: #3a3a3a;
    margin-right: 9px;
    flex-shrink: 0;
    background-size: 12px 12px;
    background-position: center;
    background-repeat: no-repeat;
}

.haste-footer-icon:hover {
    background-color: #3a3a3a;
    border-color: #4a4a4a;
}

.haste-footer-icon--indexing { border-color: #c9762c; }

.haste-status {
    font-size: 11px;
    color: #6b6b6b;
    flex-shrink: 1;
    overflow: hidden;
}

.haste-action-label {
    font-size: 11px;
    color: #c8c8c8;
    margin-right: 6px;
}

.haste-key {
    min-width: 18px;
    padding-top: 2px;
    padding-right: 5px;
    padding-bottom: 2px;
    padding-left: 5px;
    border-radius: 4px;
    background-color: #2e2e2e;
    border-width: 1px;
    border-color: #3b3b3b;
    font-size: 10px;
    color: #9c9c9c;
    -unity-text-align: middle-center;
}

.haste-footer-hint {
    flex-direction: row;
    align-items: center;
    margin-left: 10px;
}

.haste-footer-separator {
    width: 1px;
    height: 16px;
    background-color: #2e2e2e;
    margin-right: 4px;
    margin-left: 4px;
}

.haste-count {
    flex-shrink: 0;
    padding-top: 2px;
    padding-right: 7px;
    padding-bottom: 2px;
    padding-left: 7px;
    margin-right: 9px;
    border-radius: 5px;
    background-color: rgba(201, 118, 44, 0.33);
    border-width: 1px;
    border-color: #c9762c;
    font-size: 10px;
    color: #f5e0c8;
}
